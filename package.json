{
  "name": "snaprun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/ensure-deps.mjs",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w @snaprun/server\" \"npm run dev -w @snaprun/web\"",
    "predev:web": "node scripts/ensure-deps.mjs",
    "dev:web": "npm run dev -w @snaprun/web",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "npm run build -w @snaprun/web && npm run build -w @snaprun/server",
    "start": "npm run start -w @snaprun/server",
    "pretypecheck": "node scripts/ensure-deps.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "node scripts/ensure-deps.mjs",
    "test": "npm run test --workspaces --if-present",
    "predb:migrate": "node scripts/ensure-deps.mjs",
    "db:migrate": "npm run db:migrate -w @snaprun/server",
    "predesktop:dev": "node scripts/ensure-deps.mjs",
    "desktop:dev": "npm run dev -w @snaprun/desktop",
    "predesktop:build": "node scripts/ensure-deps.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "pretest:browser": "node scripts/ensure-deps.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "preformat": "node scripts/ensure-deps.mjs",
    "format": "prettier --write .",
    "preformat:check": "node scripts/ensure-deps.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "playwright-core": "1.65.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
