{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapRun",
  "version": "0.1.0",
  "identifier": "com.snaprun.companion",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev:web -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build -w @snaprun/web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnapRun",
        "url": "index.html",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#111216"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "shortDescription": "Your Snapchat companion",
    "longDescription": "An independent companion for local contacts, preferences and official Snapchat handoffs. No Snapchat passwords or private message access.",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] } },
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": true } }
  }
}
