{
  "name": "@snaprun/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/migrate-cli.ts --format esm --platform node --target node22 --sourcemap --clean",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@snaprun/shared": "*",
    "@electric-sql/pglite": "0.5.15",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/ws": "8.18.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
