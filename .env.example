# Copy to .env at the repository root. Never commit real secrets.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Comma-separated exact origins; no wildcards. Use HTTPS in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420
# postgres = deployed PostgreSQL; pglite = single-process local development only.
DB_DRIVER=postgres
DATABASE_URL=postgresql://snaprun:change-me@localhost:5432/snaprun
DATABASE_SSL=false
# Required in production: exactly 64 hex characters (32 random bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Only the local-development driver can generate a persisted key automatically.
DATA_DIR=.data
SESSION_DAYS=7
TRUST_PROXY=0
# Optional: serve apps/web/dist from the API on the same origin.
SERVE_WEB=false
